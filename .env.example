# ============================================================================
# FarmacIA Back-End — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# ATENÇÃO: Nunca comite o arquivo .env no repositório!
# ============================================================================

# Chave da API Google (Gemini)
GOOGLE_API_KEY="sua-chave-google-aqui"

# Chave OpenRouter (para acesso a modelos via API)
OPEN_ROUTER_API_KEY="sua-chave-openrouter-aqui"

# Chave Groq (para inferência rápida)
GROQ_API_KEY="sua-chave-groq-aqui"

# Chave HuggingFace (para download de modelos)
HF_APY_KEY="sua-chave-huggingface-aqui"

# Desabilita telemetria do ChromaDB
ANONYMIZED_TELEMETRY=False
